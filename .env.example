# Copy to .env for local use:  cp .env.example .env     (.env is git-ignored - never commit it)
# Everything below is OPTIONAL. With nothing set, the app runs on the clearly-labelled local fallback model.

# --- QuickML endpoint (copy from the published endpoint's details page in the Catalyst console) ---
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=
CATALYST_ORG=

# --- Auth: EITHER a refresh-token flow (recommended: access tokens expire) ... ---
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# --- ... OR a short-lived access token (scope QuickML.deployment.READ) ---
QUICKML_TOKEN=

# --- Request shape: copy from the endpoint's "Sample Request" ---
# single_data = one request per row, body {"data": {"timestamp": "...", ...}} (matches endpoint sample request)
# batch_data  = one request with a list, body {"data": [{...}, {...}]} (only if endpoint supports batches)
# single      = legacy flat one-row body {feature: value, ...}
QUICKML_PAYLOAD_MODE=single_data
# This endpoint was trained with the raw numeric weather columns (timestamp is included in request envelope).
QUICKML_FEATURES=ambient_temp_c,humidity_pct,solar_irradiance_wm2
QUICKML_TIMEOUT=20
